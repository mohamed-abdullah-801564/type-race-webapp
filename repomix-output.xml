                    >
                        Return to Dashboard
                    </Link>
                </div>
            </div>
        );
    };

    const renderNickname = () => {
        return (
            <div className="flex flex-col items-center justify-center h-full max-w-md mx-auto space-y-8 animate-in fade-in zoom-in duration-700 mt-20">
