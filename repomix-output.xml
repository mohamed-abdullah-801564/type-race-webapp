@import "tailwindcss";

@theme {
    --color-primary: #00f5d4;
    --color-background-light: #f5f8f8;
    --color-background-dark: #0f2320;
    --font-display: "Inter", sans-serif;
    --font-mono: "JetBrains Mono", monospace;
    --radius: 0.25rem;
    --radius-lg: 0.5rem;
    --radius-xl: 0.75rem;
    --radius-full: 9999px;
}

@custom-variant dark (&:where(.dark, .dark *));

@layer utilities {
    .chart-glow {
        filter: drop-shadow(0 0 8px rgba(0, 245, 212, 0.4));
    }

    .cursor-blink {
        display: inline-block;
        width: 2px;
        height: 1.2em;
        background-color: var(--color-primary);
        box-shadow: 0 0 8px var(--color-primary);
        vertical-align: middle;
        margin-left: -1px;
        animation: blink 1s step-end infinite;
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    .faded-ui {
        opacity: 0.5;
        transition: opacity 0.3s ease;
    }

    .faded-ui:hover {
        opacity: 1;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--color-primary);
        opacity: 0.3;
        border-radius: 4px;
    }

    .custom-scrollbar:hover::-webkit-scrollbar-thumb {
        opacity: 0.8;
    }
}

body,
#root {
    @apply min-h-screen bg-background-light text-slate-900 selection:bg-primary/30;
}

body,
html {
    -ms-overflow-style: none;
    /* IE and Edge */
    scrollbar-width: none;
    /* Firefox */
}

body::-webkit-scrollbar,
html::-webkit-scrollbar {
    display: none;
    /* Chrome, Safari and Opera */
}

.dark {
    @apply bg-background-dark text-slate-100;
}
