                setPrivateGhosts(local);

                // Load Global Ghosts
                const q = query(collection(db, 'global_ghosts'), orderBy('wpm', 'desc'), limit(10));
                const snapshot = await getDocs(q);
                const global = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                setGlobalGhosts(global);
