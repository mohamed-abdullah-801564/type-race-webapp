            const attempts = hits + errors;
            const errorRate = attempts > 0 ? errors / attempts : 0;
            preKeyStats[k] = { avg, hits, errors, errorRate };
        }

        localStorage.setItem(
            ADAPTIVE_DRILL_STORAGE_KEY,
            JSON.stringify({
                text: drillText,
                duration: 60,
                worstKeys,
                preKeyStats,
                category: 'code',
                difficulty: 'medium',
                mode: 'standard'
            })
        );

        navigate('/solo');
    };

