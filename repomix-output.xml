                    </div>
                </div>

                {/* Dashboard Stats Row */}
                <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-12">
                    <div className="bg-white/[0.02] border border-white/5 p-4 rounded-xl flex items-center gap-4">
