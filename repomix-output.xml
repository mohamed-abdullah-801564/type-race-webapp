                    >
                        Continue to Arena
                    </button>
                </form>
            </div>
        );
    };

    return (
        <div className="layout-container flex flex-col min-h-screen">
            <main className="flex-1 flex flex-col w-full relative">
                {!playerName ? renderNickname() : (
                    <>
                        {gameState === 'lobby' && renderLobby()}
